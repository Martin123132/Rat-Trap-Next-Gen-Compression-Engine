<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 uap10 rescap">

  <Identity
    Name="__PACKAGE_NAME__"
    Publisher="__PUBLISHER__"
    Version="__PACKAGE_VERSION__"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Rat-Trap</DisplayName>
    <PublisherDisplayName>__PUBLISHER_DISPLAY_NAME__</PublisherDisplayName>
    <Description>Compression, storage, queryable vaults, and Sealed Files.</Description>
    <Logo>Assets\StoreLogo.png</Logo>
    <uap10:PackageIntegrity>
      <uap10:Content Enforcement="on" />
    </uap10:PackageIntegrity>
  </Properties>

  <Resources>
    <Resource Language="en-gb" />
  </Resources>

  <Dependencies>
    <TargetDeviceFamily
      Name="Windows.Desktop"
      MinVersion="10.0.19041.0"
      MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Applications>
    <Application
      Id="RatTrap"
      Executable="Rat-Trap.exe"
      uap10:RuntimeBehavior="packagedClassicApp"
      uap10:TrustLevel="mediumIL">
      <uap:VisualElements
        DisplayName="Rat-Trap"
        Description="Compression, storage, queryable vaults, and Sealed Files."
        BackgroundColor="transparent"
        Square44x44Logo="Assets\Square44x44Logo.png"
        Square150x150Logo="Assets\Square150x150Logo.png" />

      <Extensions>
        <uap3:Extension Category="windows.fileTypeAssociation">
          <uap3:FileTypeAssociation
            Name="rattrapsealed"
            Parameters="--open-sealed &quot;%1&quot;"
            MultiSelectModel="Single">
            <uap:DisplayName>Rat-Trap Sealed File</uap:DisplayName>
            <uap:Logo>Assets\RTSF.png</uap:Logo>
            <uap:InfoTip>Authenticated encrypted and compressed Rat-Trap file.</uap:InfoTip>
            <uap:SupportedFileTypes>
              <uap:FileType ContentType="application/vnd.rat-trap.sealed">.rtsf</uap:FileType>
            </uap:SupportedFileTypes>
          </uap3:FileTypeAssociation>
        </uap3:Extension>

        <uap3:Extension Category="windows.fileTypeAssociation">
          <uap3:FileTypeAssociation
            Name="rattraparchive"
            Parameters="--open-archive &quot;%1&quot;"
            MultiSelectModel="Single">
            <uap:DisplayName>Rat-Trap GMW Archive</uap:DisplayName>
            <uap:Logo>Assets\GMW.png</uap:Logo>
            <uap:InfoTip>Rat-Trap compressed archive or queryable vault.</uap:InfoTip>
            <uap:SupportedFileTypes>
              <uap:FileType ContentType="application/vnd.rat-trap.gmw">.gmw</uap:FileType>
            </uap:SupportedFileTypes>
          </uap3:FileTypeAssociation>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
